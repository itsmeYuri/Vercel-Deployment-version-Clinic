# Supabase PostgreSQL transaction-pooler URL for serverless deployments (normally port 6543).
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_DATABASE_PASSWORD@POOLER_HOST:6543/postgres
# Keep require for remote PostgreSQL; use disable only for a local development database.
CLINIC_DB_SSLMODE=require

# Local MariaDB alternative to the PostgreSQL URL above.
CLINIC_DB_HOST=127.0.0.1
CLINIC_DB_PORT=3306
CLINIC_DB_NAME=YOUR_LOCAL_DATABASE_NAME
CLINIC_DB_USER=YOUR_LOCAL_DATABASE_USER
CLINIC_DB_PASS=YOUR_LOCAL_DATABASE_PASSWORD

# Supabase project API and Storage credentials.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=lab-results

# Production adapters. Vercel also selects database sessions automatically.
CLINIC_STORAGE_DRIVER=supabase
CLINIC_SESSION_DRIVER=database
CLINIC_SESSION_TTL=43200
CLINIC_COOKIE_SECURE=1
CLINIC_ALLOW_DEMO_HASHES=0

# Application behavior.
CLINIC_APP_TIMEZONE=Asia/Manila
CLINIC_APP_DEBUG=0
CLINIC_APP_NAME=Centralized Laboratory Results System
CLINIC_PAGE_SIZE=25
CLINIC_PREVIEW_LIMIT=6
CLINIC_SCANNER_LANGUAGE=eng

# Patient AI assistant (server-side only).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3-flash-preview

# Authenticator secret encryption. Generate locally: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
CLINIC_MFA_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_KEY

# Google Cloud OAuth 2.0 Web application credentials and exact callback URL.
CLINIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
CLINIC_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_WEB_CLIENT_SECRET
CLINIC_GOOGLE_REDIRECT_URI=http://127.0.0.1:8099/public/auth/google.php
