# Supabase PostgreSQL transaction-pooler URL (port 6543 is recommended for Vercel).
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase project API and Storage credentials.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace_with_project_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_STORAGE_BUCKET=lab-results

# Production adapters. Vercel also selects database sessions automatically.
CLINIC_STORAGE_DRIVER=supabase
CLINIC_SESSION_DRIVER=database
CLINIC_SESSION_TTL=43200
CLINIC_COOKIE_SECURE=1

# Application behavior.
CLINIC_APP_TIMEZONE=Asia/Manila
CLINIC_APP_DEBUG=0
